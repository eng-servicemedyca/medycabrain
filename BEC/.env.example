# ── Django ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=medycabrain.messtudent.com,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.base
CORS_ALLOWED_ORIGINS=https://medycabrain.messtudent.com,http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://medycabrain_user:CHANGE_ME@localhost:5432/medycabrain
DB_SSL_REQUIRE=false

# ── Modelli: Groq prima, il modello locale come riserva ─────────────────
# La catena ha due anelli e basta: Groq (remoto, gratuito) e poi Ollama (sul
# server). Niente Anthropic, niente rivenditori, niente HuggingFace.
# "fast" = i provider di LLM_ENDPOINTS qui sotto; "ollama" = il modello locale.
LLM_PROVIDER_ORDER=fast,ollama
LLM_ENDPOINTS=groq

# Groq: gratuito, senza carta — https://console.groq.com/keys
# Ha un tetto di token AL MINUTO e uno AL GIORNO per modello: il codice aspetta
# il minuto che serve e, sul tetto giornaliero, passa ai modelli fratelli.
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
LLM_GROQ_MODEL_ANALYSIS=openai/gpt-oss-120b
LLM_GROQ_MODEL_BULK=openai/gpt-oss-20b
# Riserve sullo stesso provider: i piani gratuiti limitano i token al giorno
# PER MODELLO, quindi un modello fratello ha ancora budget suo.
LLM_GROQ_MODEL_CHAIN=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# Modello locale. Apache 2.0, già scaricato (4,7 GB). NON usare il 3b: la sua
# licenza è «solo ricerca, non commerciale».
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# Thread usati per generare. 6 è il più veloce misurato su questo VDS (18 è ~5x più lento); 0 = decide Ollama.
OLLAMA_NUM_THREAD=6
# Il 7b è LENTO (legge 13 token/s, scrive 2,8: circa 4 minuti per un'analisi
# media, fino a 9 per la più lunga). Per questo:
#   finestra di 8192 token (quella di Ollama era 4096: un'analisi ci stava per 260);
OLLAMA_NUM_CTX=8192
#   il modello resta in memoria 30 minuti (ricaricarlo costa 96-123 secondi);
OLLAMA_KEEP_ALIVE=30m
#   silenzio ammesso prima del primo token, e tetto di una risposta intera:
OLLAMA_READ_TIMEOUT=600
OLLAMA_PIPELINE_TIMEOUT=1500
# Chiamate al modello locale che UN giro può fare (circa 40 = 2,8 ore). Superate,
# lo stadio si ferma e lascia in attesa (pending) quello che non ha provato.
# 0 = nessun tetto.
PIPELINE_LOCAL_MAX_CALLS=40
# Quante volte si aspetta il tetto AL MINUTO di Groq (ogni volta quanto dice lui,
# al massimo 21 secondi) prima di ripiegare sul modello locale.
LLM_RATE_WAITS=6
# Un contenuto alla volta: il limite è il tetto al minuto di Groq, non i fili.
ENRICH_WORKERS=1
# Giorni in cui si tiene il dettaglio di ogni chiamata al modello (pagina Avanzamento).
LLM_CALL_RETENTION_DAYS=90

# Trascrizione audio: endpoint separato di proposito — un gateway di solo
# testo non espone /audio/transcriptions e ogni richiesta finirebbe in 404,
# ricadendo sul modello locale che storpia "ormoni bioidentici".
FAST_LLM_BASE_URL=https://api.groq.com/openai/v1
FAST_LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Whisper ─────────────────────────────────────────────────────────────
WHISPER_MODEL=small          # small | medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4

# ── Embeddings ──────────────────────────────────────────────────────────
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Connettore MCP ──────────────────────────────────────────────────────
# Indirizzo del brain (la UI React) usato per costruire il link che ogni
# riferimento dell'MCP porta con sé: {BRAIN_BASE_URL}/content/{reel|blog}/{id}.
# Va cambiato il giorno in cui il brain prende un dominio: un link vecchio in
# una citazione è peggio di nessun link. In produzione si imposta qui.
BRAIN_BASE_URL=http://144.91.123.46:9093
# Indirizzo pubblico HTTPS del connettore (Caddy + Cloudflare): lo usa la
# pagina d'invito per costruire il link {MCP_PUBLIC_URL}/{MCP_SECRET}/mcp.
MCP_PUBLIC_URL=https://mcp.medyca.it
# Altri indirizzi di ritorno OAuth ammessi, separati da virgola (claude.ai e claude.com sono già inclusi).
MCP_OAUTH_REDIRECTS=

# ── Video presi da un link ──────────────────────────────────────────────
# yt-dlp scarica l'audio dei video che il cliente incolla. Da un server in
# datacenter YouTube risponde "Sign in to confirm you're not a bot": serve un
# file di cookie esportato da un browser dove sei loggato. Senza, il link
# resta salvato come riferimento (titolo, canale, link) ma non trascritto.
YT_COOKIES_FILE=
# Idem per Vimeo, che senza cookie risponde "The web client only works when
# logged-in". Due file distinti: sono due account diversi.
VIMEO_COOKIES_FILE=
# Proxy residenziale (IPRoyal, IP italiano): se valorizzato, YouTube e Vimeo
# scaricano da lì senza cookie. `{session}` diventa un id nuovo a ogni download.
# Contiene una password: solo qui in .env, mai nel repository. Vuoto = cookie.
# Dettaglio: documentation/low-level/02-pipeline.md, «Proxy residenziale».
YTDLP_PROXY=
# Proxy per leggere Instagram (raccolta dei reel) e, solo se il download diretto
# viene bloccato, per scaricare. Vuoto = usa YTDLP_PROXY (di solito basta così).
# Contiene una password: solo qui, mai nel repository.
IG_PROXY=
